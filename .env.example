# Server-side credentials only. Never prefix secrets with NEXT_PUBLIC_.
FIREWORKS_API_KEY=
MODEL_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# Workspace persistence: local SQLite unless both Supabase settings are supplied.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRIPPIE_DATA_DIR=private/runtime
# Server-only credentials. Device bearer token; cloud admin Basic auth user: trippie.
TRIPPIE_DEVICE_TOKEN=
TRIPPIE_ADMIN_PASSWORD=

# Operator CLI target (no trailing path; no credentials in this URL).
TRIPPIE_PORTAL_URL=https://www.fixitplano.com
